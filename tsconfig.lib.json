{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.vue",
    "src/composables/**/*.ts",
    "src/shared/**/*.ts"
  ],
  "exclude": ["src/main.ts", "src/App.vue", "src/**/*.test.ts"]
}
