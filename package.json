{
  "name": "@mario9/wasm-player",
  "version": "0.1.2",
  "type": "module",
  "description": "基于 Vue 3 + mediabunny 的媒体播放器，支持 H.264、H.265/HEVC 视频和 MP3 音频",
  "keywords": [
    "vue3",
    "video-player",
    "h265",
    "hevc",
    "h264",
    "mediabunny",
    "webcodecs",
    "canvas",
    "media-player",
    "vue-component"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hmfw/wasm-player.git"
  },
  "homepage": "https://github.com/hmfw/wasm-player#readme",
  "bugs": {
    "url": "https://github.com/hmfw/wasm-player/issues"
  },
  "license": "MIT",
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/player.css",
    "dist/components",
    "dist/composables",
    "dist/shared",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "BUILD_MODE=lib vue-tsc --project tsconfig.lib.json --noEmit && BUILD_MODE=lib vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "mediabunny": ">=1.44.0"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.8"
  }
}
